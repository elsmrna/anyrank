	<string>$(STEAM_WEB_API_KEY)</string>
	<key>TMDBReadToken</key>
	<string>$(TMDB_READ_TOKEN)</string>
	<key>TwitchClientID</key>
	<string>$(TWITCH_CLIENT_ID)</string>
	<key>TwitchClientSecret</key>
	<string>$(TWITCH_CLIENT_SECRET)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
